########## demo/07-history-daily-tier-missing.json ##########
$ sh qa/harness/server-up.sh false && sh qa/harness/agent-up.sh qa-node-01  -> exit 0
$ NOW_MS=$(python3 -c 'import time;print(int(time.time()*1000))'); D29=$((NOW_MS - 29*86400000)); /public/tianyuyang/code/ClusterScope-review/pg16/bin/psql 'postgresql://clusterscope:clusterscope@127.0.0.1:5432/clusterscope' -tAc "insert into metrics_daily (node_id, metric_name, day_bucket, avg_value, max_value, min_value, p95_value, sample_count) values ('qa-node-01','cpu_usage_percent', (to_timestamp($D29/1000.0))::date, 21.0, 22.0, 20.0, 21.5, 7) on conflict (node_id, metric_name, day_bucket) do update set avg_value = excluded.avg_value; select 'daily rows matching the server filter: ' || count(*) from metrics_daily where node_id='qa-node-01' and day_bucket >= to_timestamp($((NOW_MS - 30*86400000))/1000.0) and day_bucket <= to_timestamp($NOW_MS/1000.0);"  -> exit 0
$ NOW_MS=$(python3 -c 'import time;print(int(time.time()*1000))'); D30=$((NOW_MS - 30*86400000)); curl -s "http://127.0.0.1:8080/api/metrics/history?node_id=qa-node-01&start_time_ms=$D30&end_time_ms=$NOW_MS" > /tmp/hist.json; echo "rows=$(jq length /tmp/hist.json)"; jq -c '[.[] | (.source // "raw")] | group_by(.) | map({source: .[0], rows: length})' /tmp/hist.json  -> exit 0
$ grep -n 'day_bucket DATE' crates/storage/src/lib.rs; sed -n '167,194p' crates/storage/src/queries.rs; sed -n '273,285p' crates/server/src/handlers.rs  -> exit 0
$ /public/tianyuyang/code/ClusterScope-review/pg16/bin/psql 'postgresql://clusterscope:clusterscope@127.0.0.1:5432/clusterscope' -tAc "select count(*) from metrics_daily where day_bucket >= now() - interval '30 days';"  -> exit 0
$ sh qa/harness/agent-down.sh && sh qa/harness/server-down.sh  -> exit 0
