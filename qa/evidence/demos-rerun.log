$ T=$(curl -s -X POST -H 'Content-Type: application/json' -d '{"username":"admin","password":"admin123"}' http://127.0.0.1:8080/api/login | jq -r .access_token); J=$(curl -s -X POST -H "Authorization: Bearer $T" -H 'Content-Type: application/json' -d '{"node_id":"qa-node-01","name":"qa-pid-demo","executable":"/bin/sh","arguments":["-c","echo qa-pid-demo; sleep 3"],"working_directory":"/tmp"}' http://127.0.0.1:8080/api/jobs | jq -r .job_id); echo "job_id=$J"; PSQL=/public/tianyuyang/code/ClusterScope-review/pg16/bin/psql; PG='postgresql://clusterscope:clusterscope@127.0.0.1:5432/clusterscope'; for i in $(seq 1 60); do s=$($PSQL "$PG" -tAc "select status from jobs where job_id='$J'"); [ "$s" = "succeeded" ] && break; sleep 1; done; echo '--- agent 日志（它知道真实 pid）---'; grep -h 'Process spawned' gauntlet-out/qa/agent.log | sed 's/\x1b\[[0-9;]*m//g' | tail -1; echo '--- 数据库行（任务已经 succeeded，pid 仍是 NULL）---'; $PSQL "$PG" -tAc "select job_id || ' | ' || status || ' | pid=' || coalesce(pid::text,'NULL') from jobs where job_id='$J'"  -> exit 0
