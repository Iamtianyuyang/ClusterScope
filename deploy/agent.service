# System-wide unit -- OPTIONAL, requires root: install into /etc/systemd/system/
# and `systemctl enable --now clusterscope-agent`. It runs as User=clusterscope and
# reads /etc/clusterscope/agent.yaml. The no-root default is the user-level unit
# deploy/clusterscope-agent.service (systemctl --user).
[Unit]
Description=ClusterScope GPU Agent
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/clusterscope-agent --config /etc/clusterscope/agent.yaml
Restart=always
RestartSec=5
User=clusterscope
Group=clusterscope
LogsDirectory=/var/log/clusterscope-agent
WorkingDirectory=/var/lib/clusterscope

[Install]
WantedBy=multi-user.target
