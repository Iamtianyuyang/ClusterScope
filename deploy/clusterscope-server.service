# User-level systemd unit -- the default, no root required.
#
#   mkdir -p ~/.config/systemd/user
#   cp deploy/clusterscope-server.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now clusterscope-server
#
# %h expands to the installing user's home directory; the server reads its
# config (postgres_url, ports, jwt_secret) from %h/.config/clusterscope/server.yaml.
# No system-wide variant is supported: no step needs root/sudo.
#
# Requires a running user manager (systemd --user). To survive logout, enable
# linger for this user when the system allows it (`loginctl enable-linger $USER`);
# otherwise use a user crontab @reboot entry. Do not escalate to root.
[Unit]
Description=ClusterScope Central Server (user)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clusterscope server %h/.config/clusterscope/server.yaml
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
