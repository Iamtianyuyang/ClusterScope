# System-wide unit -- OPTIONAL, requires root: install into /etc/systemd/system/
# and `systemctl enable --now clusterscope-server`. It runs as User=clusterscope and
# reads /etc/clusterscope/server.yaml. The no-root default is the user-level unit
# deploy/clusterscope-server.service (systemctl --user).
[Unit]
Description=ClusterScope Central Server
After=network.target postgresql.service redis.service

[Service]
Type=simple
ExecStart=/usr/local/bin/clusterscope-server /etc/clusterscope/server.yaml
Restart=always
RestartSec=5
User=clusterscope
Group=clusterscope
LogsDirectory=/var/log/clusterscope-server
WorkingDirectory=/var/lib/clusterscope
Environment=PATH=/usr/local/rustup/toolchains/1.97.1-x86_64-unknown-linux-gnu/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin

[Install]
WantedBy=multi-user.target
